{
  "sticky_scroll": {
    "enabled": true
  },
  "proxy": "",
  "disable_ai": true,
  "debugger": {
    "stepping_granularity": "statement"
  },
  "agent": {
    "sidebar_side": "right",
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "show_count_badge": true,
    "tree_view": true,
    "default_width": 300.0,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.6
  },
  "focus_follows_mouse": {},
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "title_bar": {
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_branch_status_icon": true
  },
  "terminal": {
    "copy_on_select": true,
    "show_count_badge": true,
    "dock": "right",
    "cursor_shape": "bar",
    "env": {
      "RUST_BACKTRACE": "1"
    }
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true
  },
  "project_panel": {
    "hide_root": true,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "auto_reveal_entries": false,
    "entry_spacing": "standard",
    "default_width": 300.0,
    "dock": "left"
  },
  "file_finder": {},
  "search": {
    "button": false,
    "center_on_match": true
  },
  "use_smartcase_search": true,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "lsp_results_location": "picker",
  "markdown_preview": {
    "max_width": 100.0
  },
  "colorize_brackets": true,
  "middle_click_paste": false,
  "code_lens": "on",
  "inlay_hints": {
    "show_type_hints": false,
    "enabled": true
  },
  "completion_menu_item_kind": "symbol",
  "format_on_save": "modifications_if_available",
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false
  },
  "minimap": {
    "thumb_border": "right_open",
    "thumb": "hover",
    "display_in": "all_editors",
    "show": "auto"
  },
  "scrollbar": {},
  "gutter": {
    "min_line_number_digits": 4
  },
  "hover_popover_delay": 100,
  "auto_signature_help": true,
  "which_key": {
    "delay_ms": 0,
    "enabled": true
  },
  "hide_mouse": "never",
  "ui_font_size": 15.0,
  "buffer_line_height": "standard",
  "buffer_font_weight": 300.0,
  "buffer_font_size": 14.2,
  "buffer_font_family": "FiraCode Nerd Font",
  "theme": "One Dark Pro",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "default_open_behavior": "new_window",
  "use_system_prompts": false,
  "use_system_path_prompts": false,
  "when_closing_with_no_tabs": "close_window",
  "wrap_guides": [100],
  "ssh_connections": [
    {
      "host": "192.168.2.200",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/storage/stacks/syncthing-atilo/Home/rust/iex/./"]
        }
      ]
    },
    {
      "host": "192.168.2.99",
      "username": "atilo",
      "args": [],
      "projects": [
        {
          "paths": ["/etc/nixos/./"]
        }
      ],
      "nickname": "fileserver"
    }
  ],
  "file_types": {
    "JSON": ["*.gltf"]
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "lsp": {
    "cargo-tom": {
      "initialization_options": {
        "hide_docs_info_message": true
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all"
        },
        "check": {
          "command": "clippy",
          "features": "all"
        },
        "inlayHints": {
          "bindingModeHints": {
            "enable": true
          },
          "closureReturnTypeHints": {
            "enable": "with_block"
          },
          "closureStyle": "rust_analyzer",
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "privateEditable": {
            "enable": true
          },
          "typeHints": {
            "enable": false
          }
        }
      }
    }
  }
}
